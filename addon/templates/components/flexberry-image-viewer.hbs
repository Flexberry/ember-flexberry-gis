{{#if (and availableEdit (not feature.arch) visibleAddPhoto)}}
  <a class="attach-img-button" onclick={{action "onAddPhoto"}}><i class="icon-guideline-plus icon"></i>Добавить изображения</a>
{{/if}}
<div class="flexberry-image-viewer">
  {{#each displayedImages as |image index|}}
      <a class="preview" onclick={{action "showCurrent" index}}>
        {{image-loader
          token=token
          imageUrl=image.preview
        }}
      </a>
  {{/each}}

  {{#if (gt images.length displayedImagesLimit)}}
    <a class="preview more" onclick={{action "toggleShowAll"}}>
      {{#if showAll}}Скрыть{{else}}Смотреть все{{/if}}
    </a>
  {{/if}}
</div>

{{#if galleryDialogIsRequested}}
  {{#flexberry-dialog
    class="basic fullscreen carousel"
    visible=galleryDialogIsRequested
    hide=(action "onHideCarousel")
    closable=true
    flexberryClassNames=(hash toolbar="hidden" header="hidden" closeButton="hidden")
  }}
    {{flexberry-carousel
      activeIndex=activeIndex
      images=images
      token=token
      feature=feature
      availableEdit=availableEdit
      onAddPhoto=(action "onAddPhoto")
      onHideCarousel=(action "onHideCarousel")
      onShowDeletePhoto=(action "onShowDeletePhoto")}}

  {{/flexberry-dialog}}
{{/if}}

{{#if showFileAdd}}
  {{#flexberry-dialog
    class="attach-img-dialog"
    visible=showFileAdd
    flexberryClassNames=(hash toolbar="hidden" header="hidden" closeButton="hidden")
  }}
    <div class="attach-img-dialog-header">
      <div class="header">Прикрепление изображений</div>
      <button class="ui button" onclick={{action "onDeny"}}><i class="icon-guideline-arrow-long-back"></i>Отменить загрузку</button>
    </div>
    <div class="field">
      {{flexberry-files
        uploadUrl=uploadUrlFiles
        inputClass="fluid"
        showUploadButton=false
        showDownloadButton=false
        showPreview=true
        readonly=false
        relatedModel=_relatedModelStub
        showModalDialogOnDownloadError=false
        showModalDialogOnUploadError=false
        accept="image/jpeg, image/jpg, image/png"
        maxUploadFileSize=20
        maxUploadFileSizeUnit="Mb"
        value=filesJson
        _uploadIsInProgress=uploadIsInProgressFiles
        label="Файл"
      }}
    </div>
    <div class="attach-img-dialog-actions">
      <button class="ui button attach {{if (not filesJson) "disabled"}}" onclick={{action "onApprove"}}>Загрузить файлы<i class="icon-guideline-arrow-long-next"></i></button>
    </div>
  {{/flexberry-dialog}}
{{/if}}

{{#if showFileDelete}}
  {{#flexberry-dialog
    caption="Внимание"
    approveButtonCaption="Удалить"
    denyButtonCaption="Отмена"
    visible=showFileDelete
    hide=(action "onHideDeletePhoto")
    approve=(action "delete")
  }}
    <p>
      Фотография будет удалена без возможности восстановления.<br>
      Продолжить действие?
    </p>
  {{/flexberry-dialog}}
{{/if}}