<div class="flexberry-image-viewer">
    {{#each limitImages as |image index|}}
        <div class="preview">
            <img class="img-responsive" src={{image.preview}} />
        </div>
    {{/each}}

    {{#if images}}
        <div class="preview more" onclick={{action "showAll"}}>
            Смотреть все
        </div>
    {{else}}
        <div class="preview more">
            Нет данных
        </div>
    {{/if}}
</div>

{{#if galleryDialogIsRequested}}
    {{#flexberry-dialog
        class="carousel"
        visible=galleryDialogIsVisible
        hide=(action "onHideCarousel")
    }}
    <div>
        {{#flexberry-carousel
            images=images
            onAddPhoto=(action "onAddPhoto")
            onHideCarousel=(action "onHideCarousel")
            onShowDeletePhoto=(action "onShowDeletePhoto")
        }}
        {{/flexberry-carousel}}
    </div>

    {{/flexberry-dialog}}

{{/if}}

{{#if showFileAdd}}
  {{#flexberry-dialog
    caption="Прикрепление файлов"
    approveButtonCaption="Загрузить фото"
    denyButtonCaption="Отменить загрузку"
    visible=showFileAdd
    show=(action "onAddPhoto")
    hide=(action "onHideAddFile")
    approve=(action "savePhoto")
  }}
  <div class="field">
    {{flexberry-files
      uploadUrl=uploadUrlFiles
      inputClass="fluid"
      showUploadButton=false
      showDownloadButton=false
      showPreview=true
      readonly=false
      relatedModel=_relatedModelStub
      showModalDialogOnDownloadError=false
      showModalDialogOnUploadError=false
      accept="image/jpeg, image/jpg, image/png"
      maxUploadFileSize=20
      maxUploadFileSizeUnit="Mb"
      value=filesJson
      showUploadButton=true
    }}
  </div>
  {{/flexberry-dialog}}
{{/if}}

{{#if showFileDelete}}
  {{#flexberry-dialog
    caption="Внимание"
    approveButtonCaption="Удалить"
    denyButtonCaption="Отмена"
    visible=showFileDelete
    show=(action "onShowDeletePhoto")
    hide=(action "onHideDeletePhoto")
  }}
  <p>
    Фотография будет удалена без возможности восстановления.<br>
    Продолжить действие?
  </p>
  {{/flexberry-dialog}}
{{/if}}