<div class="flexberry-carousel-header">
  <span class="file-name">{{currentImage.fileName}}</span>
  <div class="actions">
    {{#if (and availableEdit (not feature.arch) (gt total 0))}}
      <button class="ui button" onclick={{action "delete"}}><i class="icon-guideline-delete"></i>Удалить</button>
    {{/if}}
    {{#if (and availableEdit (not feature.arch))}}
      <button class="ui button" onclick={{action "add"}}><i class="icon-guideline-plus"></i>Добавить</button>
    {{/if}}
    <button class="ui button cancel" title="Закрыть"><i class="icon-guideline-cross-r"></i></button>
  </div>
</div>

<div class="flexberry-carousel-container">
  {{#if (gt total 0)}}
    <div class="flexberry-carousel-body">
      <div class="flexberry-carousel-items">
        {{#each images as |image index|}}
          <div class="{{concat "flexberry-carousel-item " image.from (if (eq index activeIndex) " active") (if image.slidingIn " slide-in") (if image.slidingOut " slide-out")}}">
            {{#image-loader
              token=token
              imageUrl=image.preview
            }}
            {{/image-loader}}
          </div>
        {{/each}}
      </div>
      <span>{{math/add activeIndex 1}} из {{total}}</span>
    </div>

    <div class="flexberry-carousel-nav">
      <button class="ui button icon-guideline-navigate-arrow-left" onclick={{action "prev"}}></button>
      <button class="ui button icon-guideline-navigate-arrow" onclick={{action "next"}}></button>
    </div>
  {{else}}
    <div class="flexberry-carousel-item no-data">
      Нет данных
    </div>
  {{/if}}
</div>

{{#if (gt total 0)}}
  <div class="flexberry-carousel-footer">
      Добавлено: <br>
      {{currentImage.creator}}
      {{currentImage.createTime}}
  </div>
{{/if}}