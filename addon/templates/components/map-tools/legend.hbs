{{#drag-box
  additionalClassName="legend-drag-panel"
  container=".mappanel"
  top=panelTop
  left=panelLeft
  bottom=panelBottom
  right=panelRight
  visible=showPanel
  clearPositionOnHide=false
  resizable=true
}}
<div class="container">
    <h3 class="{{titleClass}}">Легенда карты</h3>
  <div class="div-tools">

    {{#if (not hasLayers)}}
      <p class="not-found">Нет доступных слоев для отображения</p>
    {{else}}
      {{#each layers as |layer|}}
        {{#if (not layer.isDeleted)}}
          <div>
            <div class={{flexberryClassNames.caption}}>
              {{layer.name}}
            </div>

            {{#if (and layer.layerInitialized layer.legendCanBeDisplayed)}}
              {{component
                (concat "legends/" layer.legendType "-legend")
                layer=layer
              }}
            {{/if}}
          </div>
        {{/if}}
      {{/each}}
    {{/if}}

  </div>
  <a
    title={{lagendCloseCaption}}
    class="{{flexberryClassNames.prefix}} {{flexberryClassNames.close}} item"
    {{action "closePanel"}}
  >
    <i class="close icon {{flexberryClassNames.icon}} icon"></i>
  </a>
</div>
{{/drag-box}}

{{map-commands/base
  class=(concat flexberryClassNames.wrapper " " class)
  name="base"
  caption=caption
  tooltip=tooltip
  iconClass=iconClass
  leafletMap=leafletMap
  click=(action "togglePanel")
}}