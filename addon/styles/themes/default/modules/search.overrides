/*******************************
         Theme Overrides
*******************************/

.flexberry-search-panel {
  .flexberry-search {
    width: 100%;
  }
  .flexberry-search.ui.search {
    .attr:before {
      font-family: Crimean;
      content: "\e82f";
    }
    .ui.search-button {
      position: absolute;
      right: 32px;
      border: none;
      height: 40px;
    }
    .ui.clear-search-button {
      position: absolute;
      right: 62px;
      border: none;
      height: 40px;
    }
    .ui.attr-search-button {
      position: absolute;
      right: 2px;
      border: none;
      height: 40px;
      width: 24px;
    }
    .ui.icon.separate {
      position: relative;
      right: 13px;
      height: 23px;
      border-left: 1px solid #E5E5E5;
      top: 6px;
    }
  }
  .flexberry-search-attr {
    border: 1px solid @lightgraycolor;
    background: @whitecolor;
    box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.15);
    border-radius: 3.5px;
    margin: 17px 0px;
    height: 170px;
    position: relative;
    .field.layers {
      margin: 14px 15px 8px 22px;
    }
    .field.properties {
      margin: 0px 16px 20px 22px;
    }
    .ui.icon.close-attr-search {
      background: transparent;
      color: @primaryColor;
      position: absolute;
      border: 0px;
      right: 0px;
      top: 0px;
      padding: 0;
      line-height: 1;
    }
  }
}

/* Sidebar search */
div.sidebar.search div.item.expanded {
    padding-bottom: 14px;
}

table.result.fields {
    margin-bottom: 2px;
}

div.details {
    border: 1px solid rgba(34, 36, 38, 0.1);
    margin-bottom: 2px;
}

.details a.detail.caption {
    padding: 6px 0px;

    width: 100%;
    display: block;
}

div.detail {
    padding: 2px 0.7em;
}

.layer-search-panel .flexberry-search.ui.search,
.outer-search.flexberry-search-panel .flexberry-search.ui.search {
  display: block;
  border-radius: @defaultBorderRadius;
  input.prompt {
    width: 320px !important;
    border: @defaultGrayBorder !important;
    color: @textColor;
    height: 40px;
    border-radius: 3.5px !important;
    padding-left: 11px;
    padding-right: 80px;
    text-overflow: ellipsis;
    input.ember-text-field {
      background-color: @whitecolor;
    }
  }

  button.ui.icon {
    border: none;
    color: @darkbluecolor;
    padding: 0;
    outline: none;
    top: 0;
    &.separate {
      position: absolute;
      top: 8px;
      right: 28px;
      border-left: 1px solid #DDE1E6;
      i.icon {
        width: auto;
        margin: 0;
      }
    }
    .icon-guideline-cross-r {
      font-size: 18px;
      color: @blueyGreyColor;
    }

    .icon {
      &.remove:before {
        content: '\e806';
        font-size: 12px;
        color: @greyIconColor;
      }
      &.search:before {
        content: "\e803";
        font-size: 20px;
        opacity: 1;
      }
      &.attr {
        margin: 0 0 10px;
      }
      &.attr:before {
        font-size: 8px;
        opacity: 1;
      }
    }

    &.search-button:hover {
      .search:before {
        color: @buttonHoverColor;
      }
    }
    &.clear-search-button:hover {
      .remove:before {
        color: @buttonHoverColor !important;
      }
    }
  }
  .dropdown {
    background-color: @whitecolor;
    &.active {
      background-color: @lightbluecolor;
    }
  }
}

.layer-search-panel {
  width: 320px;
  box-shadow: @defaultBoxShadow;
  border-radius: @defaultBorderRadius;
  margin-bottom: 10px;

  .flexberry-search {
    width: 100%;
  }

  .flexberry-search.ui.search {
    .ui.search-button {
      position: absolute;
      right: 5px;
      border: none;
      height: 40px;
    }
    .ui.clear-search-button {
      position: absolute;
      right: 34px;
      border: none;
      height: 40px;
    }
  }
}